# CareDose Backend Environment Configuration
# Copy this file to .env and fill in your PostgreSQL database credentials.
# Never commit .env to version control.

PORT=3000
NODE_ENV=development

# Main PostgreSQL database connection URL (transaction pooler)
DATABASE_URL="postgresql://postgres:password@localhost:5432/caredose?schema=public"

# Direct PostgreSQL database connection URL for migrations (session pooler or direct)
DIRECT_URL="postgresql://postgres:password@localhost:5432/caredose?schema=public"

# Dedicated PostgreSQL test database URL (never point at production)
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/caredose_test?schema=public"

# Authentication secret (replace with a strong random value in .env)
JWT_SECRET="replace-with-a-secure-secret-at-least-32-chars"
