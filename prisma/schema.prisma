generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VerificationStatus {
  VERIFIED
  UNVERIFIED
  NEEDS_REVIEW
}

enum FieldStatus {
  PRESENT
  MISSING
  UNAVAILABLE
  INVALID
}

enum MedicationStatus {
  ACTIVE
  ARCHIVED
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum DoseEventStatus {
  PLANNED
  TAKEN
  SKIPPED
}

enum InventoryTransactionType {
  OPENING_STOCK
  PURCHASE
  DOSE_CONSUMPTION
  WASTAGE
  ADJUSTMENT
}

enum GlucoseUnit {
  MG_DL
  MMOL_L
}

enum ReadingContext {
  FASTING
  BEFORE_MEAL
  AFTER_MEAL
  OTHER
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  passwordHash     String
  displayName      String
  glucoseUnit      GlucoseUnit      @default(MG_DL)
  currency         String           @default("BDT")
  monthlyBudget    Decimal?         @db.Decimal(12, 2)
  remindersEnabled Boolean          @default(true)
  soundEnabled     Boolean          @default(true)
  reminderLeadMins Int              @default(10)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  patientProfiles  PatientProfile[]
}

model PatientProfile {
  id                 String              @id @default(uuid())
  ownerUserId        String
  ownerUser          User                @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name               String
  relationship       String              @default("Self")
  timezone           String              @default("Asia/Dhaka")
  isDefault          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  medications        PatientMedication[]
  purchases          Purchase[]
  healthReadings     HealthReading[]

  @@index([ownerUserId])
}

model CatalogueImportBatch {
  id             String            @id @default(uuid())
  sourceName     String
  sourceBaseUrl  String?
  schemaVersion  String
  generatedAt    DateTime?
  importedAt     DateTime          @default(now())
  genericsCount  Int               @default(0)
  brandsCount    Int               @default(0)
  packsCount     Int               @default(0)
  groupsCount    Int               @default(0)
  status         String            @default("COMPLETED")
  notes          String?
  generics       MedicineGeneric[]
  brands         MedicineBrand[]
}

model MedicineGeneric {
  id             String               @id @default(uuid())
  sourceId       String               @unique
  idSource       String               @default("site")
  name           String
  normalizedName String
  slug           String?
  sourceUrl      String?
  collectedAt    DateTime?
  verification   VerificationStatus   @default(UNVERIFIED)
  importBatchId  String?
  importBatch    CatalogueImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  brands         MedicineBrand[]
  altGroups      AlternativeGroup[]

  @@index([normalizedName])
}

model MedicineBrand {
  id                 String                  @id @default(uuid())
  sourceId           String                  @unique
  name               String
  normalizedName     String
  genericId          String?
  generic            MedicineGeneric?        @relation(fields: [genericId], references: [id], onDelete: SetNull)
  strength           String?
  strengthNorm       String?
  dosageForm         String?
  dosageFormNorm     String?
  manufacturer       String?
  manufacturerSourceId String?
  category           String                  @default("allopathic")
  releaseMarker      String?
  productUrl         String?
  collectedAt        DateTime?
  verification       VerificationStatus      @default(UNVERIFIED)
  genericFieldStatus FieldStatus             @default(PRESENT)
  strengthFieldStatus FieldStatus            @default(PRESENT)
  formFieldStatus    FieldStatus             @default(PRESENT)
  mfrFieldStatus     FieldStatus             @default(PRESENT)
  priceFieldStatus   FieldStatus             @default(PRESENT)
  warnings           String[]                @default([])
  importBatchId      String?
  importBatch        CatalogueImportBatch?   @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  packs              MedicinePack[]
  images             MedicineImage[]
  alternativeLinks   AlternativeGroupBrand[]
  patientMedications PatientMedication[]

  @@index([normalizedName])
  @@index([genericId, dosageFormNorm, strengthNorm])
}

model MedicinePack {
  id             String             @id @default(uuid())
  brandId        String
  brand          MedicineBrand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  packQuantity   String?
  packUnits      Int?
  unitPrice      Decimal?           @db.Decimal(12, 2)
  packPrice      Decimal?           @db.Decimal(12, 2)
  currency       String             @default("BDT")
  unitPriceLabel String?
  priceSource    String             @default("brand_page")
  sourceUrl      String?
  collectedAt    DateTime?
  verification   VerificationStatus @default(UNVERIFIED)
  warnings       String[]           @default([])
  createdAt      DateTime           @default(now())

  @@index([brandId])
}

model AlternativeGroup {
  id                    String                  @id @default(uuid())
  sourceGroupId         String                  @unique
  genericId             String
  generic               MedicineGeneric         @relation(fields: [genericId], references: [id], onDelete: Cascade)
  strengthNorm          String
  dosageFormNorm        String
  releaseMarker         String?
  isCombination         Boolean                 @default(false)
  requiresReviewReasons String[]                @default([])
  createdAt             DateTime                @default(now())
  brands                AlternativeGroupBrand[]

  @@index([genericId, strengthNorm, dosageFormNorm])
}

model AlternativeGroupBrand {
  id                 String           @id @default(uuid())
  alternativeGroupId String
  alternativeGroup   AlternativeGroup @relation(fields: [alternativeGroupId], references: [id], onDelete: Cascade)
  brandId            String
  brand              MedicineBrand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([alternativeGroupId, brandId])
  @@index([brandId])
}

model MedicineImage {
  id               String             @id @default(uuid())
  brandId          String
  brand            MedicineBrand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  imageUrl         String
  sourceName       String             @default("Arogga")
  sourcePageUrl    String?
  permissionStatus String             @default("UNRECORDED")
  matchStatus      VerificationStatus @default(UNVERIFIED)
  checkedAt        DateTime           @default(now())

  @@index([brandId])
}

model PatientMedication {
  id                    String                 @id @default(uuid())
  patientId             String
  patient               PatientProfile         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  catalogueBrandId      String?
  catalogueBrand        MedicineBrand?         @relation(fields: [catalogueBrandId], references: [id], onDelete: SetNull)
  name                  String
  genericName           String?
  strength              String?
  dosageForm            String?
  manufacturer          String?
  personalInstructions  String
  stockRemaining        Decimal                @default(0) @db.Decimal(12, 2)
  stockUnit             String                 @default("tablets")
  lowStockThreshold     Decimal                @default(5) @db.Decimal(12, 2)
  status                MedicationStatus       @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  schedules             MedicationSchedule[]
  doseEvents            DoseEvent[]
  inventoryTransactions InventoryTransaction[]
  purchases             Purchase[]

  @@index([patientId, status])
}

model MedicationSchedule {
  id                  String            @id @default(uuid())
  patientMedicationId String
  patientMedication   PatientMedication @relation(fields: [patientMedicationId], references: [id], onDelete: Cascade)
  doseAmount          Decimal           @default(1) @db.Decimal(10, 2)
  doseUnit            String            @default("tablet")
  frequency           String            @default("DAILY")
  scheduledTimes      String[]
  startDate           DateTime
  endDate             DateTime?
  instructions        String?
  remindersEnabled    Boolean           @default(true)
  status              ScheduleStatus    @default(ACTIVE)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  doseEvents          DoseEvent[]

  @@index([patientMedicationId, status])
}

model DoseEvent {
  id                   String                @id @default(uuid())
  scheduleId           String
  schedule             MedicationSchedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  patientMedicationId  String
  patientMedication    PatientMedication     @relation(fields: [patientMedicationId], references: [id], onDelete: Cascade)
  scheduledFor         DateTime
  status               DoseEventStatus       @default(PLANNED)
  recordedAt           DateTime?
  note                 String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  inventoryTransaction InventoryTransaction?

  @@unique([scheduleId, scheduledFor])
  @@index([patientMedicationId, scheduledFor])
}

model InventoryTransaction {
  id                  String                   @id @default(uuid())
  patientMedicationId String
  patientMedication   PatientMedication        @relation(fields: [patientMedicationId], references: [id], onDelete: Cascade)
  doseEventId         String?                  @unique
  doseEvent           DoseEvent?               @relation(fields: [doseEventId], references: [id], onDelete: SetNull)
  purchaseId          String?                  @unique
  purchase            Purchase?                @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  type                InventoryTransactionType
  quantityDelta       Decimal                  @db.Decimal(12, 2)
  balanceAfter        Decimal                  @db.Decimal(12, 2)
  reason              String?
  note                String?
  createdAt           DateTime                 @default(now())

  @@index([patientMedicationId, createdAt])
}

model Purchase {
  id                   String                @id @default(uuid())
  patientId            String
  patient              PatientProfile        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientMedicationId  String
  patientMedication    PatientMedication     @relation(fields: [patientMedicationId], references: [id], onDelete: Cascade)
  purchaseDate         DateTime
  packCount            Int
  unitsPerPack         Decimal               @db.Decimal(12, 2)
  totalUnitsAdded      Decimal               @db.Decimal(12, 2)
  amountPaid           Decimal               @db.Decimal(12, 2)
  currency             String                @default("BDT")
  vendor               String?
  note                 String?
  createdAt            DateTime              @default(now())
  inventoryTransaction InventoryTransaction?

  @@index([patientId, purchaseDate])
  @@index([patientMedicationId, purchaseDate])
}

model HealthReading {
  id         String         @id @default(uuid())
  patientId  String
  patient    PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  value      Decimal        @db.Decimal(10, 2)
  unit       GlucoseUnit    @default(MG_DL)
  context    ReadingContext @default(FASTING)
  measuredAt DateTime
  note       String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([patientId, measuredAt])
}
